<UserControl x:Class="WinInstagram.Views.CommandPaletteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="True"
             AutomationProperties.Name="Command palette. Type to filter every WinInstagram command, then press Enter to run one."
             d:DesignHeight="560" d:DesignWidth="640">
    <Grid Background="#CC000000">
        <Border Background="#1E1E1E" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="12"
                Padding="20" Width="640" MaxHeight="560"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="⌘ Command Palette (Ctrl+K)" Foreground="#FFFFFF"
                           FontSize="18" FontWeight="Bold" Margin="0,0,0,12"
                           AutomationProperties.HeadingLevel="Level1" />

                <TextBox x:Name="TxtPaletteFilter" Grid.Row="1" Padding="10,8" Background="#262626"
                         Foreground="White" BorderBrush="#444444" FontSize="14" Margin="0,0,0,10"
                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="TxtPaletteFilter_KeyDown"
                         AutomationProperties.Name="Type to filter commands. Press Enter to run the selected command, or Down Arrow to move into the list." />

                <ListBox x:Name="MatchesList" Grid.Row="2"
                         ItemsSource="{Binding Matches}"
                         SelectedItem="{Binding SelectedCommand, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" MinHeight="140"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         KeyDown="MatchesList_KeyDown"
                         AutomationProperties.Name="Matching commands. Use Up and Down arrows to read them, Enter to run one.">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleDescription}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#141414" CornerRadius="6" Padding="10" BorderBrush="#2A2A2A" BorderThickness="1">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="{Binding Gesture}" Foreground="#4EC9B0" FontSize="11"
                                                   FontWeight="Bold" DockPanel.Dock="Right" VerticalAlignment="Center"
                                                   Visibility="{Binding HasGesture, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <TextBlock Text="{Binding Label}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Description}" Foreground="#AAAAAA" FontSize="12"
                                               TextWrapping="Wrap" Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="3" Text="{Binding StatusText}" Foreground="#888888" FontSize="11"
                           TextWrapping="Wrap" Margin="0,8,0,0" />

                <TextBlock Grid.Row="4" Text="Up / Down: choose  •  Enter: run  •  Escape: close"
                           Foreground="#666666" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
