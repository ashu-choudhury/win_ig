<UserControl x:Class="WinInstagram.Views.ReelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="True"
             AutomationProperties.Name="Reels panel. Shows details of the reel playing in the web view and a list of reels you have already watched."
             d:DesignHeight="700" d:DesignWidth="520"
             KeyDown="UserControl_KeyDown">
    <Grid Background="#141414">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Now playing -->
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#2D2D30" BorderThickness="0,0,0,1" Padding="14,10">
            <StackPanel>
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="#1F3A34" CornerRadius="10" Padding="8,2">
                        <TextBlock Text="{Binding PlaybackStatusText}" Foreground="#4EC9B0" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="🎬 Now Playing" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"
                               AutomationProperties.HeadingLevel="Level1" />
                </DockPanel>

                <TextBlock Text="{Binding CurrentReel.Username, StringFormat='@{0}', FallbackValue='No reel playing'}"
                           Foreground="#E1306C" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"
                           AutomationProperties.Name="{Binding CurrentReel.Username, StringFormat='Creator: {0}'}" />

                <TextBlock Text="{Binding CurrentReel.AudioTitle, StringFormat='🎵 {0}', FallbackValue=''}"
                           Foreground="#A0A0A0" FontSize="12" Margin="0,3,0,0"
                           AutomationProperties.Name="{Binding CurrentReel.AudioTitle, StringFormat='Audio: {0}'}" />

                <WrapPanel Margin="0,8,0,0">
                    <Border Background="#2A2A2A" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                        <TextBlock Text="{Binding CurrentReelLikesText}" Foreground="#FF6B81" FontSize="12" FontWeight="Bold" />
                    </Border>
                    <Border Background="#2A2A2A" CornerRadius="6" Padding="8,4" Margin="0,0,6,6">
                        <TextBlock Text="{Binding CurrentReelCommentsText}" Foreground="#AAAAAA" FontSize="12" />
                    </Border>
                </WrapPanel>

                <TextBlock Text="{Binding CurrentReelCaption}" Foreground="#E0E0E0" FontSize="13"
                           TextWrapping="Wrap" MaxHeight="90" Margin="0,4,0,0"
                           AutomationProperties.Name="Reel caption" />

                <!-- The only description of what the video shows, so it is always on screen. -->
                <TextBlock Text="{Binding CurrentReelAltText}" Foreground="#9CDCFE" FontSize="12"
                           TextWrapping="Wrap" MaxHeight="70" Margin="0,6,0,0"
                           AutomationProperties.Name="Image description" />

                <!-- Captions, read from the video's own caption track, shown once they were read out. -->
                <Border Background="#141414" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="6"
                        Padding="10,8" Margin="0,8,0,0"
                        Visibility="{Binding HasCaptionsText, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="🎧 Captions (T)" Foreground="#4EC9B0" FontSize="12" FontWeight="Bold" />
                        <TextBlock Text="{Binding CaptionsText}" Foreground="#D0D0D0" FontSize="12"
                                   TextWrapping="Wrap" MaxHeight="120" Margin="0,4,0,0"
                                   AutomationProperties.Name="Video captions" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Playback and action buttons -->
        <Border Grid.Row="1" Background="#181818" Padding="12,10">
            <StackPanel>
                <UniformGrid Columns="3" Margin="0,0,0,6">
                    <Button x:Name="BtnPrev" Content="◀ Prev (J)" Click="Prev_Click"
                            Background="#2A2A2A" Foreground="White" Padding="8,8" Margin="0,0,4,0"
                            AutomationProperties.Name="Previous reel. Press J or K." />
                    <Button x:Name="BtnPlayPause" Content="{Binding PlayButtonText}" Click="PlayPause_Click"
                            Background="#2A2A2A" Foreground="White" Padding="8,8" Margin="2,0,2,0"
                            AutomationProperties.Name="Play or pause the reel. Press Spacebar." />
                    <Button x:Name="BtnNext" Content="Next ▶ (K)" Click="Next_Click"
                            Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="8,8" Margin="4,0,0,0"
                            AutomationProperties.Name="Next reel. Press K." />
                </UniformGrid>

                <UniformGrid Columns="4">
                    <Button x:Name="BtnMute" Content="{Binding MuteButtonText}" Click="Mute_Click"
                            Background="#2A2A2A" Foreground="White" Padding="8,8" Margin="0,0,4,0"
                            AutomationProperties.Name="Toggle audio mute. Press M." />
                    <Button x:Name="BtnLike" Content="{Binding CurrentReel.ReelLikeButtonText, FallbackValue='🤍 Like'}"
                            Click="Like_Click"
                            Background="#2A2A2A" Foreground="White" Padding="8,8" Margin="2,0,2,0"
                            AutomationProperties.Name="Like or unlike this reel. Press L." />
                    <Button x:Name="BtnShare" Content="🔗 Share (S)" Click="Share_Click"
                            Background="#2A2A2A" Foreground="White" Padding="8,8" Margin="2,0,2,0"
                            AutomationProperties.Name="Copy this reel's link. Press S." />
                    <Button x:Name="BtnComments" Content="💬 (C)" Click="Comments_Click"
                            Background="#2A2A2A" Foreground="White" Padding="8,8" Margin="4,0,0,0"
                            AutomationProperties.Name="Open the accessible comments list. Press C." />
                </UniformGrid>

                <UniformGrid Columns="3" Margin="0,6,0,0">
                    <Button x:Name="BtnCaptions" Content="🎧 Captions (T)" Click="Captions_Click"
                            Background="#2A2A2A" Foreground="White" Padding="8,8" Margin="0,0,4,0"
                            AutomationProperties.Name="Read out the captions of this video. Press T." />
                    <Button x:Name="BtnDescribe" Content="🔎 Describe (D)" Click="Describe_Click"
                            Background="#2A2A2A" Foreground="White" Padding="8,8" Margin="2,0,2,0"
                            AutomationProperties.Name="Read out a description of what is on screen. Press D." />
                    <Button x:Name="BtnSave" Content="💾 Save (Ctrl+S)" Click="Save_Click"
                            Background="#2A2A2A" Foreground="White" Padding="8,8" Margin="4,0,0,0"
                            AutomationProperties.Name="Save this media and its description to disk. Press Control S." />
                </UniformGrid>
            </StackPanel>
        </Border>

        <!-- Volume -->
        <Border Grid.Row="2" Background="#181818" Padding="14,8">
            <StackPanel>
                <TextBlock Text="{Binding VolumeText}" Foreground="#AAAAAA" FontSize="12" Margin="0,0,0,4" />
                <Slider Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}"
                        TickFrequency="0.1" SmallChange="0.05" LargeChange="0.1"
                        AutomationProperties.Name="Audio volume. Press plus or minus to change." />
            </StackPanel>
        </Border>

        <!-- Reels you have already watched -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="↺ Reels you have watched" Foreground="#4EC9B0" FontSize="12"
                       FontWeight="Bold" Margin="14,10,14,4" />

            <ListBox x:Name="HistoryList" Grid.Row="1"
                     ItemsSource="{Binding ViewedReels}"
                     SelectedItem="{Binding SelectedHistoryReel, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Margin="8,0,8,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="Reels you have watched. Use Up and Down arrows to read them, Enter to open one again.">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0,0,0,6" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleDescription}" />
                        <Setter Property="AutomationProperties.HelpText" Value="Press Enter to open this reel again in the web view." />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1E1E1E" CornerRadius="6" Padding="10" BorderBrush="#2A2A2A" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding Username, StringFormat='@{0}'}" Foreground="#E1306C"
                                           FontWeight="Bold" FontSize="13" />
                                <TextBlock Text="{Binding Caption}" Foreground="#CCCCCC" FontSize="12"
                                           TextWrapping="Wrap" MaxHeight="40" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Shortcut hint -->
        <Border Grid.Row="4" Background="#1A1A1A" Padding="12,6">
            <TextBlock Text="J / K or Down / Up: change reel  •  Space: play or pause  •  M: mute  •  L: like  •  C: comments  •  T: captions  •  D: describe  •  S: share  •  Ctrl+S: save  •  Enter: open a watched reel"
                       Foreground="#666666" FontSize="11" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
