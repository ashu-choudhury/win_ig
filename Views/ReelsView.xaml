<UserControl x:Class="WinInstagram.Views.ReelsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WinInstagram.Views"
             xmlns:vm="clr-namespace:WinInstagram.ViewModels"
             mc:Ignorable="d" 
             Focusable="True"
             AutomationProperties.Name="Reels Player. Use Down Arrow or J for next reel, Up Arrow or K for previous, Space to play or pause, M to mute, L to like, C for comments."
             d:DesignHeight="700" d:DesignWidth="900"
             KeyDown="UserControl_KeyDown"
             Loaded="UserControl_Loaded">
    <Grid Background="#121212">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- Left / Center: Accessible Direct Web Engine Player Dashboard -->
        <Border Grid.Column="0" Background="#181818" CornerRadius="8" Margin="10" Padding="20" BorderBrush="#2D2D30" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Header / Engine Mode Badge -->
                <DockPanel Grid.Row="0" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="🎬 Reels Player" Foreground="White" FontSize="20" FontWeight="Bold" />
                        <Border Background="#1F3A34" CornerRadius="10" Padding="10,3" Margin="12,0,0,0">
                            <TextBlock Text="⚡ Direct Web Engine" Foreground="#4EC9B0" FontSize="11" FontWeight="Bold" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                        <Border Background="#252526" CornerRadius="10" Padding="10,4">
                            <TextBlock Text="{Binding PlaybackStatusText}" Foreground="#CCCCCC" FontSize="12" FontWeight="SemiBold" 
                                       AutomationProperties.Name="{Binding PlaybackStatusText}" />
                        </Border>
                    </StackPanel>
                </DockPanel>

                <!-- Center: Active Reel Details Card -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel VerticalAlignment="Center" Margin="10,0">
                        <!-- Creator Row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                            <Border Width="56" Height="56" CornerRadius="28" Background="#E1306C" Margin="0,0,14,0">
                                <TextBlock Text="📸" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentReel.Username, StringFormat='@{0}'}" 
                                           Foreground="#FFFFFF" FontSize="22" FontWeight="Bold" 
                                           AutomationProperties.Name="{Binding CurrentReel.Username, StringFormat='Creator: {0}'}" />
                                <TextBlock Text="{Binding CurrentReel.AudioTitle, StringFormat='🎵 {0}'}" 
                                           Foreground="#A0A0A0" FontSize="14" Margin="0,3,0,0" 
                                           AutomationProperties.Name="{Binding CurrentReel.AudioTitle, StringFormat='Audio: {0}'}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Live Status Indicators -->
                        <WrapPanel Margin="0,0,0,16">
                            <Border Background="#2A2A2A" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                <TextBlock Text="{Binding CurrentReel.LikesDisplayText, FallbackValue='❤️ Likes'}" 
                                           Foreground="#FF6B81" FontWeight="Bold" FontSize="13" />
                            </Border>
                            <Border Background="#2A2A2A" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                <TextBlock Text="{Binding MuteButtonText, StringFormat='🔊 {0}'}" 
                                           Foreground="#64B5F6" FontWeight="SemiBold" FontSize="13" />
                            </Border>
                            <Border Background="#2A2A2A" CornerRadius="6" Padding="10,6" Margin="0,0,8,8">
                                <TextBlock Text="{Binding Volume, StringFormat='Volume: {0:P0}'}" 
                                           Foreground="#81C784" FontWeight="SemiBold" FontSize="13" />
                            </Border>
                        </WrapPanel>

                        <!-- Caption Card -->
                        <Border Background="#121212" CornerRadius="8" Padding="16" BorderBrush="#333333" BorderThickness="1" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="Caption" Foreground="#888888" FontSize="12" FontWeight="Bold" Margin="0,0,0,8" />
                                <TextBox Text="{Binding CurrentReel.Caption, Mode=OneWay}" 
                                         IsReadOnly="True" 
                                         TextWrapping="Wrap" 
                                         Background="Transparent" 
                                         Foreground="#F0F0F0" 
                                         BorderThickness="0" 
                                         FontSize="15" 
                                         FontFamily="Segoe UI"
                                         AutomationProperties.Name="Reel Caption" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Bottom Playback Controls Bar -->
                <Border Grid.Row="2" Background="#1E1E1E" CornerRadius="8" Padding="14,10" BorderBrush="#2D2D30" BorderThickness="1" Margin="0,10,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Previous Button -->
                        <Button x:Name="PrevBtn" Grid.Column="0" 
                                Content="◀ Prev (Up/K)" 
                                Click="PrevBtn_Click"
                                Background="#333333" Foreground="White" 
                                Padding="12,8" Margin="0,0,8,0"
                                AutomationProperties.Name="Previous reel. Press Up Arrow or K." />

                        <!-- Play / Pause Button -->
                        <Button x:Name="PlayPauseBtn" Grid.Column="1" 
                                Content="{Binding PlayButtonText}" 
                                Click="PlayPauseBtn_Click"
                                Background="#333333" Foreground="White" 
                                Padding="14,8" Margin="0,0,8,0"
                                AutomationProperties.Name="{Binding PlayButtonAutomationText}" />

                        <!-- Next Button -->
                        <Button x:Name="NextBtn" Grid.Column="2" 
                                Content="Next ▶ (Down/J)" 
                                Click="NextBtn_Click"
                                Background="#007ACC" Foreground="White" FontWeight="Bold"
                                Padding="14,8" Margin="0,0,8,0"
                                AutomationProperties.Name="Next reel. Press Down Arrow or J." />

                        <!-- Mute Button -->
                        <Button x:Name="MuteBtn" Grid.Column="3" 
                                Content="{Binding MuteButtonText}" 
                                Click="MuteBtn_Click"
                                Background="#333333" Foreground="White" 
                                Padding="12,8" Margin="0,0,8,0"
                                AutomationProperties.Name="Toggle Audio Mute. Press M." />

                        <!-- Status Message -->
                        <TextBlock x:Name="TxtStatus" Grid.Column="4" 
                                   Text="{Binding StatusMessage}" 
                                   Foreground="#AAAAAA" 
                                   VerticalAlignment="Center" 
                                   Margin="8,0"
                                   TextTrimming="CharacterEllipsis" 
                                   AutomationProperties.LiveSetting="Polite" />

                        <!-- Like Button -->
                        <Button x:Name="BtnQuickLike" Grid.Column="5" 
                                Content="{Binding CurrentReel.ReelLikeButtonText, FallbackValue='🤍 Like (L)'}" 
                                Click="BtnLike_Click"
                                Background="#2A2A2A" Foreground="White" 
                                Padding="12,8"
                                AutomationProperties.Name="Like reel. Press L." />
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Center-Right: Actions & Shortcuts Guide -->
        <Border Grid.Column="1" Background="#1E1E1E" CornerRadius="8" Margin="0,10,10,10" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Reel Actions" Foreground="White" FontSize="18" FontWeight="Bold" Margin="0,0,0,12" />

                    <!-- Like and Comments Buttons -->
                    <UniformGrid Columns="2" Margin="0,0,0,16">
                        <Button x:Name="BtnLike" Click="BtnLike_Click" 
                                Content="{Binding CurrentReel.ReelLikeButtonText, FallbackValue='🤍 Like (L)'}"
                                Background="#2A2A2A" Foreground="White" Padding="12" Margin="0,0,5,0"
                                AutomationProperties.Name="Like this reel. Press L."
                                AutomationProperties.HelpText="Toggles like status." />

                        <Button x:Name="BtnComments" Click="BtnComments_Click" 
                                Background="#2A2A2A" Foreground="White" Padding="12" Margin="5,0,0,0"
                                AutomationProperties.Name="Open comments drawer. Press C."
                                AutomationProperties.HelpText="Opens list of comments for this reel.">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="💬 Comments (C)" FontWeight="Bold" />
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <Separator Background="#333333" Margin="0,0,0,16" />

                    <!-- Audio Volume Control -->
                    <TextBlock Text="Engine Volume:" Foreground="#AAAAAA" FontSize="13" Margin="0,0,0,6" />
                    <Slider Minimum="0" Maximum="1" Value="{Binding Volume, Mode=TwoWay}" 
                            TickFrequency="0.1" SmallChange="0.05" LargeChange="0.1"
                            Margin="0,0,0,16"
                            AutomationProperties.Name="Audio Volume Slider. Use Left and Right arrow keys." />

                    <Separator Background="#333333" Margin="0,0,0,16" />

                    <!-- Accessible Shortcuts Reference -->
                    <Border Background="#252526" CornerRadius="6" Padding="14">
                        <StackPanel>
                            <TextBlock Text="Accessible Shortcuts:" Foreground="#4EC9B0" FontWeight="Bold" FontSize="14" Margin="0,0,0,8" />
                            <TextBlock Text="• Down Arrow / J: Next Reel (Smoothly scrolls Instagram)" Foreground="#CCCCCC" Margin="0,3" TextWrapping="Wrap" />
                            <TextBlock Text="• Up Arrow / K: Previous Reel" Foreground="#CCCCCC" Margin="0,3" />
                            <TextBlock Text="• Spacebar: Play / Pause" Foreground="#CCCCCC" Margin="0,3" />
                            <TextBlock Text="• M: Mute / Unmute" Foreground="#CCCCCC" Margin="0,3" />
                            <TextBlock Text="• L: Like Reel" Foreground="#CCCCCC" Margin="0,3" />
                            <TextBlock Text="• C: Toggle Comments Drawer" Foreground="#CCCCCC" Margin="0,3" />
                            <TextBlock Text="• + / - : Increase / Decrease Volume" Foreground="#CCCCCC" Margin="0,3" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Right Side: Comments Drawer (Toggled by C) -->
        <Border Grid.Column="2" Width="320" Background="#181818" Margin="0,10,10,10" CornerRadius="8" 
                Visibility="{Binding IsCommentsOpen, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="12">
                    <TextBlock Text="Comments" Foreground="White" FontSize="16" FontWeight="Bold" DockPanel.Dock="Left" />
                    <Button Content="Close (Esc)" Click="CloseComments_Click" DockPanel.Dock="Right" 
                            Background="#333333" Foreground="White" Padding="6,2" 
                            AutomationProperties.Name="Close comments panel" />
                </DockPanel>

                <ListBox Grid.Row="1" ItemsSource="{Binding CurrentReel.Comments}" 
                         Background="Transparent" BorderThickness="0" Margin="8,0"
                         AutomationProperties.Name="Comments list. Use Up and Down arrow keys to read comments.">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#242424" CornerRadius="6" Padding="10" Margin="0,0,0,8"
                                    AutomationProperties.Name="{Binding AccessibleText}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Username, StringFormat='@{0}'}" Foreground="#4EC9B0" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Text}" Foreground="White" TextWrapping="Wrap" Margin="0,4" />
                                    <TextBlock Text="{Binding AccessibleText}" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Background="#222222" Padding="8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtNewComment" Grid.Column="0" 
                                 Background="#333333" Foreground="White" Padding="6" 
                                 AutomationProperties.Name="Write a comment..." />
                        <Button Content="Post" Grid.Column="1" Click="PostComment_Click" 
                                Background="#007ACC" Foreground="White" Margin="6,0,0,0" Padding="10,4" 
                                AutomationProperties.Name="Post comment" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
