<UserControl x:Class="WinInstagram.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="True"
             AutomationProperties.Name="Settings panel. Speech verbosity, stories and activity behaviour, keyboard shortcuts and file locations."
             d:DesignHeight="700" d:DesignWidth="620"
             KeyDown="UserControl_KeyDown">
    <ScrollViewer Background="#141414" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">

            <TextBlock Text="⚙️ WinInstagram Settings" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold"
                       AutomationProperties.HeadingLevel="Level1" Margin="0,0,0,12" />

            <!-- Speech -->
            <Border Background="#1E1E1E" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="8"
                    Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="🔊 What WinInstagram says" Foreground="#4EC9B0" FontSize="15"
                               FontWeight="Bold" AutomationProperties.HeadingLevel="Level2" />
                    <TextBlock Text="How much the app volunteers when it speaks."
                               Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10" />

                    <ComboBox x:Name="CmbVerbosity" Width="220" HorizontalAlignment="Left"
                              SelectedIndex="{Binding VerbosityIndex, Mode=TwoWay}"
                              AutomationProperties.Name="Announcement verbosity. Choose Terse, Standard or Verbose.">
                        <ComboBoxItem Content="Terse" />
                        <ComboBoxItem Content="Standard" />
                        <ComboBoxItem Content="Verbose" />
                    </ComboBox>

                    <TextBlock Text="{Binding VerbosityHelp}" Foreground="#CCCCCC" FontSize="12"
                               TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Stories and activity -->
            <Border Background="#1E1E1E" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="8"
                    Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="📖 Stories and activity" Foreground="#4EC9B0" FontSize="15"
                               FontWeight="Bold" AutomationProperties.HeadingLevel="Level2" />

                    <CheckBox Content="Pause story auto-advance by default" Margin="0,10,0,0"
                              Foreground="White" FontSize="13"
                              IsChecked="{Binding PauseStoriesByDefault, Mode=TwoWay}"
                              AutomationProperties.Name="Pause story auto-advance by default, so a story waits for you instead of moving on to the next one." />

                    <CheckBox Content="Announce new activity (likes, comments, follows)" Margin="0,10,0,0"
                              Foreground="White" FontSize="13"
                              IsChecked="{Binding NotificationsEnabled, Mode=TwoWay}"
                              AutomationProperties.Name="Announce new activity such as likes, comments and new followers while you work." />

                    <CheckBox Content="Warn me when an Instagram control stops working" Margin="0,10,0,0"
                              Foreground="White" FontSize="13"
                              IsChecked="{Binding AnnounceSelectorWarnings, Mode=TwoWay}"
                              AutomationProperties.Name="Warn out loud when Instagram changes its page and one of the app's controls can no longer be found." />
                </StackPanel>
            </Border>

            <!-- Keyboard -->
            <Border Background="#1E1E1E" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="8"
                    Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="⌨️ Keyboard shortcuts" Foreground="#4EC9B0" FontSize="15"
                               FontWeight="Bold" AutomationProperties.HeadingLevel="Level2" />

                    <TextBlock Text="{Binding ShortcutModeText}" Foreground="#CCCCCC" FontSize="12"
                               TextWrapping="Wrap" Margin="0,8,0,10" />

                    <UniformGrid Columns="2" Margin="0,0,0,10">
                        <Button x:Name="BtnModifiedKeys" Content="Use screen reader friendly keys"
                                Click="UseModifiedKeys_Click" Margin="0,0,4,0"
                                Background="#2A2A2A" Foreground="White" Padding="10,7"
                                AutomationProperties.Name="Switch every action to Control and Shift key combinations, leaving plain letters free for your screen reader." />
                        <Button x:Name="BtnResetShortcuts" Content="Reset all shortcuts to defaults"
                                Click="ResetShortcuts_Click" Margin="4,0,0,0"
                                Background="#2A2A2A" Foreground="White" Padding="10,7"
                                AutomationProperties.Name="Reset every keyboard shortcut back to its documented default." />
                    </UniformGrid>

                    <TextBlock Text="{Binding ConflictText}" Foreground="#FFC850" FontSize="11"
                               TextWrapping="Wrap" Margin="0,0,0,10" />

                    <ListBox x:Name="ShortcutsList" ItemsSource="{Binding Shortcuts}" Height="240"
                             Background="#141414" BorderBrush="#2A2A2A" Foreground="White"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="Keyboard shortcuts. Use Up and Down arrows to read them and press Enter to rebind the focused one."
                             KeyDown="ShortcutsList_KeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleDescription}" />
                                <Setter Property="AutomationProperties.HelpText" Value="Press Enter to rebind this action." />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#1E1E1E" CornerRadius="6" Padding="10"
                                        BorderBrush="#2A2A2A" BorderThickness="1">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding GestureText}" Foreground="#4EC9B0"
                                                       FontSize="12" FontWeight="Bold" HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}" Foreground="#FFFFFF"
                                                       FontWeight="Bold" FontSize="13" DockPanel.Dock="Left" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Description}" Foreground="#AAAAAA"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Files -->
            <Border Background="#1E1E1E" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="8"
                    Padding="14" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="💾 Files" Foreground="#4EC9B0" FontSize="15" FontWeight="Bold"
                               AutomationProperties.HeadingLevel="Level2" />

                    <TextBlock Text="Saved media goes to" Foreground="#FFFFFF" FontSize="13"
                               FontWeight="SemiBold" Margin="0,8,0,4" />
                    <TextBlock Text="{Binding SaveFolder}" Foreground="#CCCCCC" FontSize="12"
                               TextWrapping="Wrap"
                               AutomationProperties.Name="{Binding SaveFolder, StringFormat='Current save folder: {0}'}" />

                    <Button x:Name="BtnChangeFolder" Content="Change folder..." Click="ChangeFolder_Click"
                            HorizontalAlignment="Left" Margin="0,10,0,0"
                            Background="#2A2A2A" Foreground="White" Padding="12,6"
                            AutomationProperties.Name="Choose a different folder for saved photos and videos." />

                    <TextBlock Text="{Binding SettingsFilePath, StringFormat='Preferences are stored in {0}'}"
                               Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusMessage}" Foreground="#4EC9B0" FontSize="12"
                       TextWrapping="Wrap" Margin="0,0,0,4"
                       AutomationProperties.LiveSetting="Polite" />

            <TextBlock Text="Enter: rebind the focused shortcut  •  Escape: cancel a rebind"
                       Foreground="#666666" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
