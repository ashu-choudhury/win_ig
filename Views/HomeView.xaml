<UserControl x:Class="WinInstagram.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WinInstagram.Views"
             mc:Ignorable="d" 
             Focusable="True"
             AutomationProperties.Name="Home Feed. Use Up and Down arrow keys to browse posts, L to like."
             d:DesignHeight="700" d:DesignWidth="800"
             KeyDown="UserControl_KeyDown">
    <Grid Background="#121212">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Instructions -->
        <Border Grid.Row="0" Background="#1E1E1E" Padding="16,12" Margin="10,10,10,0" CornerRadius="8">
            <DockPanel>
                <TextBlock Text="Home Feed" Foreground="White" FontSize="20" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                <Button Content="Refresh Feed" Click="RefreshFeed_Click" DockPanel.Dock="Right" 
                        Background="#007ACC" Foreground="White" Padding="12,6" FontWeight="SemiBold"
                        AutomationProperties.Name="Refresh timeline feed" />
                <TextBlock Text="{Binding Status}" Foreground="#AAAAAA" VerticalAlignment="Center" Margin="20,0,0,0" />
            </DockPanel>
        </Border>

        <!-- Posts List -->
        <ListBox Grid.Row="1" x:Name="PostsList" 
                 ItemsSource="{Binding Posts}" 
                 SelectedItem="{Binding SelectedPost}"
                 Background="Transparent" BorderThickness="0" 
                 Margin="10" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Instagram Timeline Posts. Press Up or Down Arrow to navigate.">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0,0,0,16" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleDescription}" />
                    <Setter Property="AutomationProperties.HelpText" Value="Press L to like this post." />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1E1E1E" CornerRadius="8" Padding="16" BorderBrush="#333333" BorderThickness="1">
                        <StackPanel>
                            <!-- Author Row -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Border Width="40" Height="40" CornerRadius="20" Background="#333333" Margin="0,0,10,0">
                                    <TextBlock Text="@" Foreground="#888888" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Username, StringFormat='@{0}'}" Foreground="White" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Timestamp}" Foreground="#888888" FontSize="12" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Media Preview (If image URL available) -->
                            <Border MaxHeight="450" Background="#0A0A0A" CornerRadius="6" Margin="0,0,0,12" ClipToBounds="True">
                                <Image Source="{Binding MediaUrl}" Stretch="Uniform" HorizontalAlignment="Center" MaxHeight="450" />
                            </Border>

                            <!-- Caption -->
                            <TextBox Text="{Binding Caption, Mode=OneWay}" 
                                     IsReadOnly="True" 
                                     TextWrapping="Wrap" 
                                     Background="Transparent" 
                                     Foreground="#E0E0E0" 
                                     BorderThickness="0" 
                                     FontSize="14" 
                                     Margin="0,0,0,12"
                                     AutomationProperties.Name="Post Caption" />

                            <!-- Bottom Metrics & Like Action -->
                            <DockPanel>
                                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                    <TextBlock Text="❤️ " Foreground="Red" FontSize="14" />
                                    <TextBlock Text="{Binding FormattedLikes}" Foreground="White" FontWeight="Bold" Margin="0,0,16,0" />
                                    <TextBlock Text="💬 " FontSize="14" />
                                    <TextBlock Text="{Binding CommentsCount, StringFormat='{}{0} comments'}" Foreground="#AAAAAA" />
                                </StackPanel>

                                <Button Content="Like (L)" 
                                        Click="LikePost_Click" 
                                        DockPanel.Dock="Right" 
                                        Background="#2A2A2A" Foreground="White" Padding="10,5"
                                        AutomationProperties.Name="Toggle like for this post" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
