<UserControl x:Class="WinInstagram.Views.SavedView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="True"
             AutomationProperties.Name="Saved posts panel. The first list contains your collections, the second contains your saved posts."
             d:DesignHeight="700" d:DesignWidth="520"
             KeyDown="UserControl_KeyDown">
    <Grid Background="#141414">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#2D2D30" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <Button x:Name="BtnRefreshSaved" DockPanel.Dock="Right" Content="🔄 Refresh (R)"
                            Click="Refresh_Click"
                            Background="#2A2A2A" Foreground="White" Padding="10,4"
                            AutomationProperties.Name="Load your saved posts and collections. Press R." />
                    <TextBlock Text="🔖 Saved" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"
                               AutomationProperties.HeadingLevel="Level1" />
                </DockPanel>
                <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="#AAAAAA" FontSize="11"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
            </Grid>
        </Border>

        <!-- Collections heading -->
        <TextBlock Grid.Row="1" Text="📁 Collections" Foreground="#4EC9B0" FontSize="12"
                   FontWeight="Bold" Margin="14,10,14,4"
                   AutomationProperties.HeadingLevel="Level2" />

        <!-- Collections -->
        <ListBox x:Name="CollectionsList" Grid.Row="2"
                 ItemsSource="{Binding Collections}"
                 SelectedItem="{Binding SelectedCollection, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Margin="8,0,8,0"
                 MaxHeight="190"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Collections. Use Up and Down arrows to read them, Enter to choose one.">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleDescription}" />
                    <Setter Property="AutomationProperties.HelpText" Value="Press Enter to list this collection's saved posts." />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1E1E1E" CornerRadius="8" Padding="12" BorderBrush="#2A2A2A" BorderThickness="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="#777777"
                                       FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding Name}" Foreground="#4EC9B0" FontWeight="Bold" FontSize="13" />
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Posts heading -->
        <TextBlock Grid.Row="3" Text="{Binding DescriptionLabel}" Foreground="#CCCCCC" FontSize="12"
                   FontWeight="Bold" Margin="14,10,14,4"
                   AutomationProperties.HeadingLevel="Level2" />

        <!-- Saved posts -->
        <ListBox x:Name="PostsList" Grid.Row="4"
                 ItemsSource="{Binding Posts}"
                 SelectedItem="{Binding SelectedPost, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Margin="8,0,8,8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Saved posts. Use Up and Down arrows to read each one, Enter to open it in the web view.">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleDescription}" />
                    <Setter Property="AutomationProperties.HelpText" Value="Press Enter to open this saved post in the web view." />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1E1E1E" CornerRadius="8" Padding="12" BorderBrush="#2A2A2A" BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding Username, StringFormat='@{0}'}" Foreground="#E1306C"
                                           FontWeight="Bold" FontSize="15" DockPanel.Dock="Left" />
                                <TextBlock Text="{Binding Timestamp}" Foreground="#888888" FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Text="{Binding Caption}" Foreground="#E0E0E0" TextWrapping="Wrap"
                                       FontSize="13" Margin="0,8,0,8" />

                            <!-- The only description of what the image shows, so it is always visible. -->
                            <TextBlock Text="{Binding AltTextLine}" Foreground="#9CDCFE" TextWrapping="Wrap"
                                       FontSize="12" Margin="0,0,0,8"
                                       Visibility="{Binding HasAltText, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Text="{Binding CarouselLine}" Foreground="#C586C0" FontSize="11"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding IsCarousel, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding LikesText}" Foreground="#FF6B81" FontSize="12" Margin="0,0,12,0" />
                                <TextBlock Text="{Binding CommentsText}" Foreground="#AAAAAA" FontSize="12" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state -->
        <TextBlock Grid.Row="4" Text="No saved posts are loaded yet.&#x0a;Press R to load your saved posts from Instagram."
                   Foreground="#777777" FontSize="13" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Margin="30" IsHitTestVisible="False"
                   Visibility="{Binding HasNoPosts, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Shortcut hint -->
        <Border Grid.Row="5" Background="#1A1A1A" Padding="12,6">
            <TextBlock Text="Up / Down: read  •  Enter: open the selected post  •  R: reload saved posts"
                       Foreground="#666666" FontSize="11" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
