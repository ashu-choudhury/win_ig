<UserControl x:Class="WinInstagram.Views.MessagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WinInstagram.Views"
             mc:Ignorable="d" 
             Focusable="True"
             AutomationProperties.Name="Direct Messages View. Left pane contains conversations, right pane contains chat."
             d:DesignHeight="700" d:DesignWidth="900">
    <Grid Background="#121212">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Pane: Conversations List -->
        <Border Grid.Column="0" Background="#1A1A1A" BorderBrush="#2C2C2C" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16,14" Background="#202020">
                    <DockPanel>
                        <TextBlock Text="Direct Messages" Foreground="White" FontSize="18" FontWeight="Bold" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        <Button Content="Sync" Click="SyncMessages_Click" DockPanel.Dock="Right" 
                                Background="#333333" Foreground="White" Padding="8,4" 
                                AutomationProperties.Name="Sync messages" />
                    </DockPanel>
                </Border>

                <ListBox Grid.Row="1" ItemsSource="{Binding Conversations}" 
                         SelectedItem="{Binding SelectedConversation}"
                         Background="Transparent" BorderThickness="0"
                         AutomationProperties.Name="Conversations List. Use Up and Down arrow keys to select conversation.">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="12,10" />
                            <Setter Property="Margin" Value="4,2" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleDescription}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#252526" CornerRadius="6" Padding="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding RecipientUsername, StringFormat='@{0}'}" Foreground="White" FontWeight="Bold" FontSize="15" />
                                    <TextBlock Text="{Binding LastMessage}" Foreground="#AAAAAA" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                    <TextBlock Text="{Binding LastTimestamp}" Foreground="#666666" FontSize="11" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Right Pane: Active Conversation & Reply Box -->
        <Border Grid.Column="1" Background="#141414">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Conversation Header -->
                <Border Grid.Row="0" Background="#1F1F1F" Padding="16,12">
                    <TextBlock Text="{Binding SelectedConversation.RecipientUsername, StringFormat='Chat with @{0}', FallbackValue='Select a conversation to start reading'}" 
                               Foreground="White" FontSize="16" FontWeight="Bold" 
                               AutomationProperties.Name="Active Chat Header" />
                </Border>

                <!-- Messages Stream -->
                <ListBox Grid.Row="1" ItemsSource="{Binding SelectedConversation.Messages}" 
                         Background="Transparent" BorderThickness="0" Margin="12"
                         AutomationProperties.Name="Messages stream. Use Up and Down arrow keys to read messages.">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,4" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleText}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#2A2A2A" CornerRadius="8" Padding="12,8" MaxWidth="500" HorizontalAlignment="Left">
                                <StackPanel>
                                    <TextBlock Text="{Binding SenderUsername}" Foreground="#4EC9B0" FontSize="12" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Text}" Foreground="White" FontSize="14" TextWrapping="Wrap" Margin="0,2" />
                                    <TextBlock Text="{Binding Timestamp}" Foreground="#888888" FontSize="10" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Reply Composer -->
                <Border Grid.Row="2" Background="#1F1F1F" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="TxtReply" Grid.Column="0" 
                                 Text="{Binding ReplyText, UpdateSourceTrigger=PropertyChanged}" 
                                 KeyDown="TxtReply_KeyDown"
                                 Background="#2D2D30" Foreground="White" 
                                 BorderBrush="#444444" Padding="10,8" FontSize="14"
                                 AutomationProperties.Name="Write a message reply. Press Enter to send." />

                        <Button Grid.Column="1" Content="Send (Enter)" Click="BtnSend_Click" 
                                Background="#007ACC" Foreground="White" FontWeight="Bold" 
                                Margin="10,0,0,0" Padding="16,8"
                                AutomationProperties.Name="Send message button" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
