<UserControl x:Class="WinInstagram.Views.StoriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="True"
             AutomationProperties.Name="Stories panel. The stories tray is listed as accessible items, and the story on screen can be paused."
             d:DesignHeight="700" d:DesignWidth="520"
             KeyDown="UserControl_KeyDown">
    <Grid Background="#141414">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#2D2D30" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <Button x:Name="BtnRefreshStories" DockPanel.Dock="Right" Content="🔄 Refresh (R)"
                            Click="Refresh_Click"
                            Background="#2A2A2A" Foreground="White" Padding="10,4"
                            AutomationProperties.Name="Load the stories tray from Instagram. Press R." />
                    <TextBlock Text="📖 Stories" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"
                               AutomationProperties.HeadingLevel="Level1" />
                </DockPanel>
                <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="#AAAAAA" FontSize="11"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
            </Grid>
        </Border>

        <!-- What the story viewer is showing right now -->
        <Border Grid.Row="1" Background="#181818" Padding="14,10">
            <StackPanel>
                <TextBlock Text="Now showing" Foreground="#4EC9B0" FontSize="11" FontWeight="Bold" />
                <TextBlock Text="{Binding NowPlayingText}" Foreground="#E0E0E0" FontSize="13"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           AutomationProperties.Name="What the story viewer is showing" />
            </StackPanel>
        </Border>

        <!-- Story tray entries -->
        <ListBox x:Name="StoriesList" Grid.Row="2"
                 ItemsSource="{Binding Stories}"
                 SelectedItem="{Binding SelectedStory, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Margin="8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Stories tray. Use Up and Down arrows to read stories, Enter to open one.">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,6" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleDescription}" />
                    <Setter Property="AutomationProperties.HelpText" Value="Press Enter to open these stories, P to pause or resume them, J and K to step through them." />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1E1E1E" CornerRadius="8" Padding="12" BorderBrush="#2A2A2A" BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="#2A2A2A" CornerRadius="10" Padding="8,2">
                                    <TextBlock Text="{Binding SeenText}" Foreground="#AAAAAA" FontSize="10" />
                                </Border>
                                <TextBlock Text="{Binding Username, StringFormat='@{0}'}" Foreground="#E1306C"
                                           FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Text="{Binding UserFullName}" Foreground="#CCCCCC" FontSize="12"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />

                            <TextBlock Text="{Binding ItemCountText}" Foreground="#4EC9B0" FontSize="11"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state -->
        <TextBlock Grid.Row="2" Text="No stories loaded yet.&#x0a;Press R to load your stories tray from Instagram."
                   Foreground="#777777" FontSize="13" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Margin="30" IsHitTestVisible="False"
                   Visibility="{Binding HasNoStories, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Story controls -->
        <Border Grid.Row="3" Background="#181818" Padding="12,10">
            <StackPanel>
                <UniformGrid Columns="3" Margin="0,0,0,6">
                    <Button x:Name="BtnPrevStory" Content="◀ Prev (K)" Click="Prev_Click"
                            Background="#2A2A2A" Foreground="White" Padding="8,8" Margin="0,0,4,0"
                            AutomationProperties.Name="Previous story. Press K." />
                    <Button x:Name="BtnPauseStories" Content="{Binding PauseButtonText}" Click="Pause_Click"
                            Background="#2A2A2A" Foreground="White" Padding="8,8" Margin="2,0,2,0"
                            AutomationProperties.Name="Pause or resume the stories playing in the web view. Press P." />
                    <Button x:Name="BtnNextStory" Content="Next ▶ (J)" Click="Next_Click"
                            Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="8,8" Margin="4,0,0,0"
                            AutomationProperties.Name="Next story. Press J." />
                </UniformGrid>
                <Button x:Name="BtnOpenStory" Content="▶ Open selected story (Enter)" Click="Open_Click"
                        Background="#2A2A2A" Foreground="White" Padding="8,7"
                        AutomationProperties.Name="Open the stories of the selected person. Press Enter." />
            </StackPanel>
        </Border>

        <!-- Shortcut hint -->
        <Border Grid.Row="4" Background="#1A1A1A" Padding="12,6">
            <TextBlock Text="Up / Down: read stories  •  Enter: open  •  P: pause or resume  •  J / K: next and previous story  •  R: refresh"
                       Foreground="#666666" FontSize="11" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
