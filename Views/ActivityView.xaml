<UserControl x:Class="WinInstagram.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="True"
             AutomationProperties.Name="Activity panel. Recent likes, comments, follows and mentions are listed as accessible items."
             d:DesignHeight="700" d:DesignWidth="520"
             KeyDown="UserControl_KeyDown">
    <Grid Background="#141414">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#2D2D30" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <Button x:Name="BtnRefreshActivity" DockPanel.Dock="Right" Content="🔄 Refresh (R)"
                            Click="Refresh_Click"
                            Background="#2A2A2A" Foreground="White" Padding="10,4"
                            AutomationProperties.Name="Reload your recent activity from Instagram. Press R." />
                    <Border DockPanel.Dock="Right" Background="#1F3A34" CornerRadius="10" Padding="8,2" Margin="0,0,8,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding NewCountText}" Foreground="#4EC9B0" FontSize="11" FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="{Binding HeaderText}" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold"
                               VerticalAlignment="Center"
                               AutomationProperties.HeadingLevel="Level1" />
                </DockPanel>
                <TextBlock Grid.Row="1" Text="{Binding Status}" Foreground="#AAAAAA" FontSize="11"
                           TextWrapping="Wrap" Margin="0,6,0,0" />
            </Grid>
        </Border>

        <!-- Activity entries -->
        <ListBox x:Name="ActivityList" Grid.Row="1"
                 ItemsSource="{Binding Items}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0" Margin="8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Recent activity. Use Up and Down arrows to read each entry.">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleDescription}" />
                    <Setter Property="AutomationProperties.HelpText" Value="Press Enter to open this activity." />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#1E1E1E" CornerRadius="8" Padding="12" BorderBrush="#2A2A2A" BorderThickness="1">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Background="#007ACC" CornerRadius="8" Padding="6,1" Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsNew, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="{Binding NewTag}" Foreground="White" FontSize="10" FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="{Binding Timestamp}" Foreground="#888888" FontSize="11"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TypeText}" Foreground="#4EC9B0" FontSize="12"
                                           FontWeight="Bold" VerticalAlignment="Center" />
                            </DockPanel>

                            <TextBlock Text="{Binding Username, StringFormat='@{0}'}" Foreground="#E1306C"
                                       FontWeight="Bold" FontSize="15" Margin="0,6,0,0" />

                            <TextBlock Text="{Binding Text}" Foreground="#E0E0E0" TextWrapping="Wrap"
                                       FontSize="13" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Empty state -->
        <TextBlock Grid.Row="1" Text="No activity loaded yet.&#x0a;Press R to load your recent likes, comments, follows and mentions."
                   Foreground="#777777" FontSize="13" TextWrapping="Wrap"
                   HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                   Margin="30" IsHitTestVisible="False"
                   Visibility="{Binding HasNoItems, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <!-- Shortcut hint -->
        <Border Grid.Row="2" Background="#1A1A1A" Padding="12,6">
            <TextBlock Text="Up / Down: read activity  •  Enter: open  •  R: refresh  •  M: mark all as read"
                       Foreground="#666666" FontSize="11" TextWrapping="Wrap" />
        </Border>
    </Grid>
</UserControl>
