<Window x:Class="WinInstagram.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WinInstagram"
        xmlns:views="clr-namespace:WinInstagram.Views"
        mc:Ignorable="d"
        Title="WinInstagram - Accessible Windows Client for Instagram" 
        Height="800" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="#121212"
        KeyboardNavigation.TabNavigation="Cycle"
        KeyDown="Window_KeyDown"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Navigation Bar -->
        <Border Grid.Row="0" Background="#1E1E1E" BorderBrush="#2D2D30" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <!-- App Title -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="📸 WinInstagram" Foreground="#E1306C" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Navigation Tabs -->
                <StackPanel x:Name="NavBar" Orientation="Horizontal" DockPanel.Dock="Left">
                    <RadioButton x:Name="NavHome" Content="Home Feed (Ctrl+1)" 
                                 Checked="NavButton_Checked" Tag="Home" TabIndex="1"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Background="#2A2A2A" Foreground="White" FontWeight="SemiBold"
                                 Padding="16,8" Margin="0,0,6,0"
                                 AutomationProperties.Name="Home feed tab. Press Ctrl+1." />

                    <RadioButton x:Name="NavReels" Content="Reels (Ctrl+2)" 
                                 Checked="NavButton_Checked" Tag="Reels" TabIndex="2"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Background="#2A2A2A" Foreground="White" FontWeight="SemiBold"
                                 Padding="16,8" Margin="0,0,6,0"
                                 AutomationProperties.Name="Reels tab. Press Ctrl+2." />

                    <RadioButton x:Name="NavSearch" Content="🔍 Search / Open Link (Ctrl+3)" 
                                 Checked="NavButton_Checked" Tag="Search" TabIndex="3"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Background="#2A2A2A" Foreground="White" FontWeight="SemiBold"
                                 Padding="16,8" Margin="0,0,6,0"
                                 AutomationProperties.Name="Search or open Instagram link tab. Press Ctrl+3." />

                    <RadioButton x:Name="NavMessages" Content="Messages (Ctrl+4)" 
                                 Checked="NavButton_Checked" Tag="Messages" TabIndex="4"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Background="#2A2A2A" Foreground="White" FontWeight="SemiBold"
                                 Padding="16,8" Margin="0,0,6,0"
                                 AutomationProperties.Name="Direct messages tab. Press Ctrl+4." />

                    <RadioButton x:Name="NavEngine" Content="Account / Login (Ctrl+L)" 
                                 Checked="NavButton_Checked" Tag="Engine" TabIndex="5"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Background="#2A2A2A" Foreground="White" FontWeight="SemiBold"
                                 Padding="16,8" Margin="0,0,6,0"
                                 AutomationProperties.Name="Account and login tab. Press Ctrl+L." />

                    <RadioButton x:Name="NavSettings" Content="⚙️ Settings (Ctrl+5)" 
                                 Checked="NavButton_Checked" Tag="Settings" TabIndex="6"
                                 Style="{StaticResource {x:Type ToggleButton}}"
                                 Background="#2A2A2A" Foreground="White" FontWeight="SemiBold"
                                 Padding="16,8" Margin="0,0,6,0"
                                 AutomationProperties.Name="Settings and integrations tab. Press Ctrl+5." />
                </StackPanel>

                <!-- Status Badge & Update Check -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button x:Name="BtnCheckUpdate" Content="🔄 Updates (Ctrl+U)" 
                            Click="BtnCheckUpdate_Click" TabIndex="5"
                            Background="#2A2A2A" Foreground="#CCCCCC" FontWeight="SemiBold"
                            Padding="10,5" Margin="0,0,10,0"
                            AutomationProperties.Name="Check for updates. Press Ctrl+U." />
                    <Border x:Name="BadgeSession" Background="#333333" CornerRadius="12" Padding="12,4">
                        <TextBlock x:Name="TxtSessionBadge" Text="Checking session..." Foreground="#AAAAAA" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main Content Area: Full Screen WebView2 Engine + Comments Drawer Overlay -->
        <Grid Grid.Row="1" Focusable="False" KeyboardNavigation.IsTabStop="False" KeyboardNavigation.TabNavigation="None">
            <!-- Full Screen Instagram WebView (Visible, Natural 60fps playback) -->
            <views:LoginView x:Name="ViewLogin" Visibility="Visible" GotFocus="ViewLogin_GotFocus" 
                             Focusable="False" KeyboardNavigation.IsTabStop="False" KeyboardNavigation.TabNavigation="None" TabIndex="99" />

            <!-- Accessible Comments Drawer Overlay (Right Side) -->
            <Border x:Name="CommentsDrawer" HorizontalAlignment="Right" Width="420"
                    Background="#1E1E1E" BorderBrush="#333333" BorderThickness="1,0,0,0"
                    Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
                <Grid Margin="16,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,10">
                        <Button x:Name="BtnCloseComments" Content="✖ Close (Esc)" DockPanel.Dock="Right"
                                Click="BtnCloseComments_Click" TabIndex="20"
                                Background="#2A2A2A" Foreground="White" Padding="10,6"
                                AutomationProperties.Name="Close comments drawer and return to reel. Press Escape." />
                        <TextBlock x:Name="TxtCommentsHeader" Text="💬 Comments" 
                                   Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"
                                   AutomationProperties.HeadingLevel="Level1" />
                    </DockPanel>

                    <!-- Accessible Comments List -->
                    <ListBox x:Name="ListComments" Grid.Row="1" Background="#141414" BorderBrush="#2A2A2A"
                             Foreground="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Margin="0,0,0,10" TabIndex="21"
                             AutomationProperties.Name="Comments list. Use Up and Down arrows to navigate comments. Press Enter to like comment."
                             KeyDown="ListComments_KeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#252525" BorderThickness="0,0,0,1" Padding="10,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                <TextBlock Text="{Binding Username, StringFormat='@{0}'}" 
                                                           Foreground="#E1306C" FontWeight="Bold" FontSize="13" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding CreatedAt}" Foreground="#888888" FontSize="11" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Text}" Foreground="#E0E0E0" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,4" />
                                            <TextBlock Text="{Binding FormattedLikes, StringFormat='❤️ {0} likes'}" 
                                                       Foreground="#AAAAAA" FontSize="11"
                                                       Visibility="{Binding LikesVisibility}" />
                                        </StackPanel>

                                        <Button Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0"
                                                Content="{Binding LikeButtonText}"
                                                Click="BtnLikeCommentItem_Click" Tag="{Binding}"
                                                Background="#2A2A2A" Foreground="White" Padding="8,5" FontSize="11"
                                                AutomationProperties.Name="{Binding AccessibleText}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Drawer Footer: Add Comment Box & Post Button -->
                    <DockPanel Grid.Row="2">
                        <Button x:Name="BtnDrawerPostComment" Content="Post" DockPanel.Dock="Right"
                                Click="BtnDrawerPostComment_Click" TabIndex="23"
                                Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="14,6" Margin="6,0,0,0"
                                AutomationProperties.Name="Post comment to reel" />
                        <TextBox x:Name="TxtDrawerComment" Padding="8,6" Background="#262626" Foreground="White"
                                 BorderBrush="#444444" KeyDown="TxtDrawerComment_KeyDown" TabIndex="22"
                                 AutomationProperties.Name="Write a comment on this reel. Type your comment and press Enter to post." />
                    </DockPanel>
                </Grid>
            </Border>

            <!-- Accessible In-App Auto-Update Modal Dialog -->
            <Border x:Name="UpdateDialog" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="520" Background="#1E1E1E" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="12"
                    Padding="24" Visibility="Collapsed" Panel.ZIndex="1000"
                    KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="🚀 WinInstagram Update Available" Foreground="#FFFFFF" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border Background="#1F3A34" CornerRadius="10" Padding="8,2" HorizontalAlignment="Right">
                            <TextBlock x:Name="TxtUpdateTag" Text="" Foreground="#4EC9B0" FontSize="12" FontWeight="Bold" />
                        </Border>
                    </DockPanel>

                    <TextBlock x:Name="TxtUpdateVersions" Text="A newer version is ready to install!" 
                               Foreground="#4EC9B0" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />

                    <Border Background="#141414" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16" MaxHeight="160">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="TxtUpdateNotes" Text="Release notes" 
                                       Foreground="#D0D0D0" TextWrapping="Wrap" FontSize="13" FontFamily="Segoe UI" />
                        </ScrollViewer>
                    </Border>

                    <!-- Progress bar shown during download -->
                    <StackPanel x:Name="UpdateProgressPanel" Visibility="Collapsed" Margin="0,0,0,14">
                        <ProgressBar x:Name="UpdateProgressBar" Height="10" Minimum="0" Maximum="100" Value="0" 
                                     Foreground="#007ACC" Background="#333333" Margin="0,0,0,6" />
                        <TextBlock x:Name="TxtUpdateProgress" Text="Downloading update: 0%..." 
                                   Foreground="#AAAAAA" FontSize="12" HorizontalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <!-- Action buttons -->
                    <UniformGrid x:Name="UpdateButtonsPanel" Columns="2" Margin="0,4,0,0">
                        <Button x:Name="BtnInstallUpdate" Content="⬇️ Download &amp; Install" 
                                Click="BtnInstallUpdate_Click" TabIndex="30"
                                Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="12,10" Margin="0,0,6,0"
                                AutomationProperties.Name="Download and install update now" />
                        <Button x:Name="BtnDismissUpdate" Content="✖ Later (Esc)" 
                                Click="BtnDismissUpdate_Click" TabIndex="31"
                                Background="#2A2A2A" Foreground="White" Padding="12,10" Margin="6,0,0,0"
                                AutomationProperties.Name="Dismiss update for now. Press Escape." />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Accessible Settings Overlay Modal Dialog -->
            <Border x:Name="SettingsOverlay" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="600" Background="#1E1E1E" BorderBrush="#007ACC" BorderThickness="2" CornerRadius="12"
                    Padding="24" Visibility="Collapsed" Panel.ZIndex="1000"
                    KeyboardNavigation.TabNavigation="Cycle">
                <StackPanel>
                    <!-- Header -->
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="⚙️ WinInstagram Settings" Foreground="#FFFFFF" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                        <Button x:Name="BtnCloseSettings" Content="✖ Close (Esc)" DockPanel.Dock="Right"
                                Click="BtnCloseSettings_Click" TabIndex="40"
                                Background="#2A2A2A" Foreground="White" Padding="10,6"
                                AutomationProperties.Name="Close settings dialog and return to app. Press Escape." />
                    </DockPanel>

                    <!-- Web-to-App Linking Section -->
                    <Border Background="#141414" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="🔗 Web-to-App Linking &amp; Sharing" Foreground="#4EC9B0" FontSize="15" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBlock Text="Configure Windows to open shared Instagram links directly in WinInstagram rather than opening an external browser."
                                       Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" />

                            <!-- Checkbox for AppUriHandler & Protocols -->
                            <CheckBox x:Name="ChkRegisterAppUri"
                                      Content="Open instagram.com links in WinInstagram"
                                      Foreground="White" FontSize="14" FontWeight="SemiBold"
                                      Checked="ChkRegisterAppUri_Checked"
                                      Unchecked="ChkRegisterAppUri_Unchecked"
                                      TabIndex="41"
                                      Margin="0,0,0,6"
                                      AutomationProperties.Name="Enable opening instagram.com links in WinInstagram" />

                            <TextBlock Text="Registers WinInstagram for web-to-app linking and system protocols (wininstagram:// &amp; instagram://)."
                                       Foreground="#888888" FontSize="11" TextWrapping="Wrap" Margin="24,0,0,12" />

                            <!-- Live Status Indicator -->
                            <Border Background="#222222" CornerRadius="6" Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Integration Status: " Foreground="#888888" FontWeight="SemiBold" FontSize="12" />
                                    <TextBlock x:Name="TxtAppUriStatus" Text="Checking..." Foreground="#4EC9B0" FontWeight="Bold" FontSize="12"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Accessible Shortcuts Reference -->
                    <Border Background="#141414" BorderBrush="#2D2D30" BorderThickness="1" CornerRadius="8" Padding="14">
                        <StackPanel>
                            <TextBlock Text="⌨️ Useful Shortcuts" Foreground="#CCCCCC" FontSize="13" FontWeight="Bold" Margin="0,0,0,6" />
                            <TextBlock Text="• Ctrl+1: Home Feed | Ctrl+2: Reels | Ctrl+3: Search &amp; Open Link | Ctrl+4: Messages | Ctrl+5: Settings" Foreground="#888888" FontSize="12" Margin="0,2" />
                            <TextBlock Text="• In Reels: S to Share link | L to Like | Space to Play/Pause | M to Mute | C for Comments" Foreground="#888888" FontSize="12" Margin="0,2" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Accessible Search & Open Instagram Link Top Bar Panel -->
            <Border x:Name="SearchBarPanel" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    Background="#1E1E1E" BorderBrush="#007ACC" BorderThickness="0,0,0,2"
                    Padding="16,12" Visibility="Collapsed" Panel.ZIndex="500">
                <DockPanel>
                    <!-- Close Search Bar button -->
                    <Button x:Name="BtnCloseSearch" Content="✖ (Esc)" DockPanel.Dock="Right"
                            Click="BtnCloseSearch_Click" TabIndex="6"
                            Background="#2A2A2A" Foreground="White" Padding="10,6" Margin="8,0,0,0"
                            AutomationProperties.Name="Close search bar. Press Escape." />

                    <!-- Paste & Open Button -->
                    <Button x:Name="BtnPasteAndOpen" Content="📋 Paste &amp; Open" DockPanel.Dock="Right"
                            Click="BtnPasteAndOpen_Click" TabIndex="5"
                            Background="#2A2A2A" Foreground="#4EC9B0" FontWeight="SemiBold" Padding="12,6" Margin="6,0,0,0"
                            AutomationProperties.Name="Paste link from clipboard and open immediately" />

                    <!-- Open Button -->
                    <Button x:Name="BtnOpenSearchLink" Content="🚀 Open Reel / Post" DockPanel.Dock="Right"
                            Click="BtnOpenSearchLink_Click" TabIndex="4"
                            Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="14,6" Margin="8,0,0,0"
                            AutomationProperties.Name="Open entered Instagram link or reel" />

                    <!-- Search / Link Input Box -->
                    <TextBox x:Name="TxtSearchInput" Padding="10,6" Background="#262626" Foreground="White"
                             BorderBrush="#444444" FontSize="14" KeyDown="TxtSearchInput_KeyDown" TabIndex="3"
                             AutomationProperties.Name="Instagram reel or post URL. Paste or type link and press Enter." />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Bottom Accessible Status Bar & Controls -->
        <Border Grid.Row="2" Background="#181818" BorderBrush="#252526" BorderThickness="0,1,0,0" Padding="12,6">
            <DockPanel>
                <!-- Reel Playback Controls (Accessible for screen readers and keyboard users) -->
                <StackPanel x:Name="ReelControlsPanel" Orientation="Horizontal" DockPanel.Dock="Left" Margin="0,0,16,0">
                    <Button x:Name="BtnPrevReel" Content="◀ Prev (PageUp/Up/K)" Click="BtnPrevReel_Click" TabIndex="10"
                            Background="#2A2A2A" Foreground="White" Padding="10,5" Margin="0,0,6,0"
                            AutomationProperties.Name="Previous reel. Press PageUp or Up Arrow." />
                    <Button x:Name="BtnPlayPauseReel" Content="⏯ Play/Pause (Space)" Click="BtnPlayPauseReel_Click" TabIndex="11"
                            Background="#2A2A2A" Foreground="White" Padding="10,5" Margin="0,0,6,0"
                            AutomationProperties.Name="Play or pause reel. Press Spacebar." />
                    <Button x:Name="BtnNextReel" Content="Next ▶ (PageDown/Down/J)" Click="BtnNextReel_Click" TabIndex="12"
                            Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="10,5" Margin="0,0,6,0"
                            AutomationProperties.Name="Next reel. Press PageDown or Down Arrow." />
                    <Button x:Name="BtnMuteReel" Content="🔊 Mute (M)" Click="BtnMuteReel_Click" TabIndex="13"
                            Background="#2A2A2A" Foreground="White" Padding="10,5" Margin="0,0,6,0"
                            AutomationProperties.Name="Toggle audio mute. Press M." />
                    <Button x:Name="BtnLikeReel" Content="❤️ Like (L)" Click="BtnLikeReel_Click" TabIndex="14"
                            Background="#2A2A2A" Foreground="White" Padding="10,5" Margin="0,0,6,0"
                            AutomationProperties.Name="Like reel. Press L." />
                    <Button x:Name="BtnShareReel" Content="🔗 Share (S)" Click="BtnShareReel_Click" TabIndex="15"
                            Background="#2A2A2A" Foreground="White" Padding="10,5" Margin="0,0,6,0"
                            AutomationProperties.Name="Share active reel. Copies link to clipboard. Press S." />
                    <Button x:Name="BtnCommentsReel" Content="💬 Comments (C)" Click="BtnCommentsReel_Click" TabIndex="16"
                            Background="#2A2A2A" Foreground="White" Padding="10,5" Margin="0,0,8,0"
                            AutomationProperties.Name="Open comments drawer. Press C." />

                    <!-- Quick Accessible Comment Input -->
                    <TextBox x:Name="TxtQuickComment" Width="180" Padding="8,4" Background="#222222" Foreground="White" 
                             BorderBrush="#444444" Margin="0,0,4,0" VerticalContentAlignment="Center"
                             KeyDown="TxtQuickComment_KeyDown" TabIndex="16"
                             AutomationProperties.Name="Write a comment on this reel. Type your comment and press Enter to post." />
                    <Button x:Name="BtnPostComment" Content="Post" Click="BtnPostComment_Click" TabIndex="17"
                            Background="#007ACC" Foreground="White" FontWeight="Bold" Padding="10,4" Margin="0,0,6,0"
                            AutomationProperties.Name="Post comment to this reel" />
                </StackPanel>

                <!-- Shortcut Legend -->
                <TextBlock Text="Ctrl+1 (Home) | Ctrl+2 (Reels) | Ctrl+3 (Search) | Ctrl+4 (Messages) | Ctrl+L (Account) | Ctrl+5 (Settings) | Ctrl+U (Updates)" 
                           Foreground="#666666" FontSize="11" VerticalAlignment="Center" DockPanel.Dock="Right" />

                <!-- Live Status Region -->
                <TextBlock x:Name="TxtFooterStatus" 
                           Text="Ready." 
                           Foreground="#AAAAAA" FontSize="13" VerticalAlignment="Center" DockPanel.Dock="Left" 
                           TextTrimming="CharacterEllipsis"
                           AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
